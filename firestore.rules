rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to get the user's role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // 1. Users Collection
    match /users/{userId} {
      // Anyone can read user profiles (needed for the public profile page and lists)
      allow read: if true;
      // Users can only create or update their own profile. Platform admins can update anyone.
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || getUserRole() == 'platform_admin' || getUserRole() == 'institution_admin');
      allow delete: if isAuthenticated() && (request.auth.uid == userId || getUserRole() == 'platform_admin');
    }

    // 2. Achievements Collection
    match /achievements/{achievementId} {
      // Anyone can read achievements (for public profiles)
      allow read: if true;
      // Only students can create achievements, and they must set themselves as the owner
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      // Students can update their own draft achievements. Authorities can update the status during verification.
      allow update: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || 
        getUserRole() == 'teacher' || 
        getUserRole() == 'institution_admin' ||
        getUserRole() == 'platform_admin'
      );
      // Only the owner can delete their achievement
      allow delete: if isAuthenticated() && resource.data.studentId == request.auth.uid;
    }

    // 3. Verification Requests Collection
    match /verificationRequests/{requestId} {
      // Only the student who requested it, the assigned authority, or admins can read the request
      allow read: if isAuthenticated() && (
        resource.data.requestedBy == request.auth.uid || 
        resource.data.requestedTo == request.auth.uid ||
        getUserRole() == 'platform_admin'
      );
      // Students can create requests, ensuring they set themselves as the requester
      allow create: if isAuthenticated() && request.resource.data.requestedBy == request.auth.uid;
      // Only the assigned authority or admins can update (approve/reject) the request
      allow update: if isAuthenticated() && (
        resource.data.requestedTo == request.auth.uid ||
        getUserRole() == 'platform_admin'
      );
      // Only the requester or admins can delete a request
      allow delete: if isAuthenticated() && (
        resource.data.requestedBy == request.auth.uid ||
        getUserRole() == 'platform_admin'
      );
    }

    // 4. Posts Collection (Community Feed)
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid || 
        getUserRole() == 'platform_admin'
      );
    }

    // 5. Student Profiles Collection
    match /studentProfiles/{profileId} {
      allow read: if true;
      allow write: if isAuthenticated() && (profileId == request.auth.uid || getUserRole() == 'platform_admin');
    }
  }
}
