rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if the user has a specific role safely
    function hasRole(role) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() && exists(userPath) && get(userPath).data.role == role;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (hasRole('platform_admin') || hasRole('institution_admin'));
      
      allow delete: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && hasRole('platform_admin');
    }

    // 2. Achievements Collection
    match /achievements/{achievementId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && (hasRole('teacher') || hasRole('institution_admin') || hasRole('platform_admin'));
      allow delete: if isAuthenticated() && resource.data.studentId == request.auth.uid;
    }

    // 3. Verification Requests Collection
    match /verificationRequests/{requestId} {
      allow read: if isAuthenticated() && resource.data.requestedBy == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.requestedTo == request.auth.uid;
      allow read: if isAuthenticated() && hasRole('platform_admin');

      allow create: if isAuthenticated() && request.resource.data.requestedBy == request.auth.uid;

      allow update: if isAuthenticated() && resource.data.requestedTo == request.auth.uid;
      allow update: if isAuthenticated() && hasRole('platform_admin');

      allow delete: if isAuthenticated() && resource.data.requestedBy == request.auth.uid;
      allow delete: if isAuthenticated() && hasRole('platform_admin');
    }

    // 4. Posts Collection (Community Feed)
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      allow delete: if isAuthenticated() && hasRole('platform_admin');
    }

    // 5. Student Profiles Collection
    match /studentProfiles/{profileId} {
      allow read: if true;
      allow write: if isAuthenticated() && profileId == request.auth.uid;
      allow write: if isAuthenticated() && hasRole('platform_admin');
    }

    // 6. Notifications Collection
    match /notifications/{notifId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Any authenticated user can create a notification (they send it to others)
      allow create: if isAuthenticated();
      // Only the recipient can mark notifications as read (update)
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Recipients and admins can delete
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && hasRole('platform_admin');
    }

    // 7. Events Collection
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated() && (hasRole('teacher') || hasRole('institution_admin'));
      allow update: if isAuthenticated() && resource.data.organiserId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.organiserId == request.auth.uid || hasRole('platform_admin'));
    }

    // 8. Institutions Collection
    match /institutions/{institutionId} {
      allow read: if true;
      allow write: if isAuthenticated() && institutionId == request.auth.uid;
      allow write: if isAuthenticated() && hasRole('platform_admin');
    }
  }
}
